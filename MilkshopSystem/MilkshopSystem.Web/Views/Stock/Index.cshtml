@model PagedResult<Stock>
@{ ViewData["Title"] = "Stock"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Stock</h3>
    <a asp-action="LowStock" class="btn btn-outline-danger">⚠ Low Stock Items</a>
</div>
<form method="get" class="d-flex mb-3" style="max-width:400px;">
    <input type="text" name="search" value="@Model.SearchTerm" class="form-control me-2" placeholder="Product name search..." />
    <button type="submit" class="btn btn-outline-secondary">Search</button>
</form>
<table class="table table-striped bg-white">
    <thead><tr><th>Product</th><th>Size</th><th>Opening Stock</th><th>Current Stock</th><th>Low Stock Level</th><th>Status</th><th>Actions</th></tr></thead>
    <tbody>
    @foreach (var s in Model.Items)
    {
        <tr class="@(s.IsLowStock ? "table-danger" : "")">
            <td>@s.ProductName</td>
            <td>@s.Size @s.UnitSymbol</td>
            <td>@s.OpeningStock</td>
            <td>@s.CurrentStock</td>
            <td>@s.LowStockLevel</td>
            <td>@(s.IsLowStock ? "LOW STOCK" : "OK")</td>
            <td><a asp-action="Edit" asp-route-id="@s.ProductId" class="btn btn-sm btn-outline-primary">Adjust</a></td>
        </tr>
    }
    </tbody>
</table>
@if (Model.TotalPages > 1)
{
    <nav><ul class="pagination">
        @for (var p = 1; p <= Model.TotalPages; p++)
        {
            <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                <a class="page-link" href="@Url.Action("Index", new { search = Model.SearchTerm, page = p })">@p</a>
            </li>
        }
    </ul></nav>
}
