@model MilkshopSystem.Web.Models.Entities.InvoiceItem
@{ ViewData["Title"] = "Edit Item"; }

<h3>Edit Item - Invoice @ViewBag.InvoiceNo</h3>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card" style="max-width:500px;">
    <div class="card-body">
        <h5 class="card-title">@Model.ProductName (@Model.Size @Model.UnitSymbol)</h5>

        <form asp-action="EditItem" method="post">
            <input type="hidden" name="invoiceId" value="@Model.InvoiceId" />
            <input type="hidden" name="itemId" value="@Model.Id" />

            <div class="mb-2">
                <label class="form-label">Price Type</label>
                <select name="priceType" class="form-select">
                    <option value="StorePrice" selected="@(Model.PriceType == "StorePrice")">Store Price</option>
                    <option value="MrpPrice" selected="@(Model.PriceType == "MrpPrice")">MRP</option>
                </select>
            </div>

            <div class="mb-2">
                <label class="form-label">Unit Price</label>
                <input type="number" step="0.01" min="0" name="unitPrice" class="form-control" value="@Model.UnitPrice" required />
            </div>

            <div class="mb-2">
                <label class="form-label">Qty</label>
                <input type="number" step="0.01" min="0.01" name="qty" class="form-control" value="@Model.Qty" required />
            </div>

            <button type="submit" class="btn btn-success">Save</button>
            <a asp-action="Details" asp-route-id="@Model.InvoiceId" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
