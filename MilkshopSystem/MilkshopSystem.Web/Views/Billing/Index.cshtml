@model PagedResult<Invoice>
@{ ViewData["Title"] = "Invoices"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Invoices</h3>
    <a asp-action="Create" class="btn btn-primary">+ New Bill</a>
</div>
<form method="get" class="d-flex mb-3" style="max-width:400px;">
    <input type="text" name="search" value="@Model.SearchTerm" class="form-control me-2" placeholder="Invoice no, customer name/phone..." />
    <button type="submit" class="btn btn-outline-secondary">Search</button>
</form>
<table class="table table-striped bg-white">
    <thead><tr><th>Invoice No</th><th>Date</th><th>Customer</th><th>Grand Total</th><th>Paid</th><th>Payment Mode</th><th>Balance</th><th>Status</th><th></th></tr></thead>
    <tbody>
    @foreach (var inv in Model.Items)
    {
        <tr>
            <td>@inv.InvoiceNo</td>
            <td>@inv.InvoiceDate.ToString("dd-MMM-yyyy hh:mm tt")</td>
            <td>@inv.CustomerName (@inv.CustomerPhone)</td>
            <td>₹@inv.GrandTotal.ToString("N2")</td>
            <td>₹@inv.PaidAmount.ToString("N2")</td>
            <td>@(inv.PaymentModeName ?? "-")</td>
            <td class="@(inv.BalanceAmount>0?"text-danger fw-bold":"")">₹@inv.BalanceAmount.ToString("N2")</td>
            <td>
                @{
                    var badge = inv.PaymentStatus switch { "Paid" => "success", "Partial" => "warning", _ => "danger" };
                }
                <span class="badge bg-@badge">@inv.PaymentStatus</span>
            </td>
            <td><a asp-action="Details" asp-route-id="@inv.Id" class="btn btn-sm btn-outline-secondary">View</a></td>
        </tr>
    }
    </tbody>
</table>
@if (Model.TotalPages > 1)
{
    <nav><ul class="pagination">
        @for (var p = 1; p <= Model.TotalPages; p++)
        {
            <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                <a class="page-link" href="@Url.Action("Index", new { search = Model.SearchTerm, page = p })">@p</a>
            </li>
        }
    </ul></nav>
}
