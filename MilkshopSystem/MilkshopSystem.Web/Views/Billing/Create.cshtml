@model BillingCreateViewModel
@{ ViewData["Title"] = Model.IsEditMode ? "Edit Invoice" : "New Bill"; }

<h3>@(Model.IsEditMode ? $"Edit Invoice - {ViewBag.InvoiceNo}" : "New Bill")</h3>

<form asp-action="@(Model.IsEditMode ? "Edit" : "Create")" asp-route-id="@Model.InvoiceId" method="post" id="billingForm">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="InvoiceId" />

    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Customer</h5>
            <div class="row">
                <div class="col-md-6 mb-2 position-relative">
                    <label class="form-label">Customer Name (typing search)</label>
                    <input type="text" id="customerSearch" class="form-control" autocomplete="off"
                           placeholder="Type name or phone..." value="@Model.CustomerName" @(Model.IsEditMode ? "readonly" : "") />
                    <div id="customerResults" class="list-group position-absolute w-100" style="z-index:1000;"></div>
                    <input type="hidden" asp-for="CustomerId" id="CustomerId" />
                    <input type="hidden" asp-for="CustomerName" id="CustomerName" />
                </div>
                <div class="col-md-4 mb-2">
                    <label class="form-label">Phone</label>
                    <input asp-for="CustomerPhone" id="CustomerPhone" class="form-control" required readonly="@Model.IsEditMode" />
                </div>
                <div class="col-md-2 mb-2">
                    <label class="form-label">Previous Balance</label>
                    <input type="text" id="previousBalanceDisplay" class="form-control" readonly value="@Model.PreviousBalance.ToString("0.00")" />
                    <input type="hidden" asp-for="PreviousBalance" id="PreviousBalance" />
                </div>
            </div>
            @if (Model.IsEditMode)
            {
                <small class="text-muted">Customer is locked for this invoice — create a new bill to change the customer.</small>
            }

            <div id="repeatOrderBox" style="display:none; margin-top:10px;" class="alert alert-light border d-flex justify-content-between align-items-center">
                <span id="repeatOrderText"></span>
                <button type="button" id="repeatOrderBtn" class="btn btn-sm btn-outline-primary">🔁 Repeat Last Order</button>
            </div>
        </div>
    </div>

    <div class="card mb-3" style="border-color:#0d6efd; background:#eef5ff;">
        <div class="card-body">
            <h5 class="card-title text-primary">📷 Scan Barcode</h5>
            <input type="text" id="barcodeInput" class="form-control" autocomplete="off" autofocus
                   placeholder="Keep the cursor here... then scan" />
            <small class="text-muted">The product is added below automatically as soon as the scanner beeps</small>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Add Product (manual search)</h5>
            <div class="row align-items-end">
                <div class="col-md-4 mb-2 position-relative">
                    <label class="form-label">Product Search</label>
                    <input type="text" id="productSearch" class="form-control" autocomplete="off" placeholder="Type product name..." />
                    <div id="productResults" class="list-group position-absolute w-100" style="z-index:1000;"></div>
                </div>
                <div class="col-md-2 mb-2">
                    <label class="form-label">Price Type</label>
                    <select id="priceType" class="form-select">
                        <option value="StorePrice">Store Price</option>
                        <option value="MrpPrice">MRP Price</option>
                    </select>
                </div>
                <div class="col-md-2 mb-2">
                    <label class="form-label">Available Stock</label>
                    <input type="text" id="availableStock" class="form-control" readonly />
                </div>
                <div class="col-md-2 mb-2">
                    <label class="form-label">Qty</label>
                    <input type="number" id="qtyInput" class="form-control" step="0.01" min="0.01" />
                </div>
                <div class="col-md-2 mb-2">
                    <button type="button" id="addItemBtn" class="btn btn-primary w-100">+ Add</button>
                </div>
            </div>
            <input type="hidden" id="selectedProductId" />
            <input type="hidden" id="selectedProductName" />
            <input type="hidden" id="selectedSize" />
            <input type="hidden" id="selectedUnitSymbol" />
            <input type="hidden" id="selectedStorePrice" />
            <input type="hidden" id="selectedMrpPrice" />
        </div>
    </div>

    <table class="table table-bordered bg-white">
        <thead><tr><th>Product</th><th>Price Type</th><th>Unit Price</th><th>Qty</th><th>Amount</th><th></th></tr></thead>
        <tbody id="itemsTableBody"></tbody>
        <tfoot>
            <tr><th colspan="4" class="text-end">Sub Total</th><th id="subTotalCell">0.00</th><th></th></tr>
            <tr><th colspan="4" class="text-end">+ Previous Balance</th><th id="prevBalanceCell">0.00</th><th></th></tr>
            <tr><th colspan="4" class="text-end">Grand Total</th><th id="grandTotalCell">0.00</th><th></th></tr>
        </tfoot>
    </table>
    <div id="itemInputs"></div>

    <div class="card mb-3" style="max-width:500px;">
        <div class="card-body">
            <h5 class="card-title">Payment</h5>
            <div class="mb-2">
                <label class="form-label">Payment Mode</label>
                <select asp-for="PaymentModeId" asp-items="Model.PaymentModes" class="form-select" required>
                    <option value="">-- select --</option>
                </select>
            </div>
            <div class="mb-2">
                <label class="form-label">Paid Amount</label>
                <input asp-for="PaidAmount" id="paidAmountInput" type="number" step="0.01" class="form-control" />
                <small class="text-muted">Full paid, partial, or 0 (unpaid) — any remaining balance will be carried forward to the next bill.</small>
            </div>
            <div>
                <strong>Balance after this payment: </strong><span id="balanceDisplay">0.00</span>
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-success btn-lg">@(Model.IsEditMode ? "Update Bill" : "Save Bill")</button>
    <a asp-action="@(Model.IsEditMode ? "Details" : "Index")" asp-route-id="@Model.InvoiceId" class="btn btn-secondary btn-lg">Cancel</a>
</form>

@section Scripts {
<script>
    let items = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Items.Select(i => new {
        productId = i.ProductId,
        name = i.ProductName,
        size = i.Size,
        unitSymbol = i.UnitSymbol,
        priceType = i.PriceType,
        unitPrice = i.UnitPrice,
        qty = i.Qty
    })));

    const customerSearch = document.getElementById('customerSearch');
    const customerResults = document.getElementById('customerResults');
    customerSearch.addEventListener('input', debounce(async () => {
        const term = customerSearch.value.trim();
        customerResults.innerHTML = '';
        if (term.length < 2) return;
        const res = await fetch(`/Customer/SearchJson?term=${encodeURIComponent(term)}`);
        const data = await res.json();
        data.forEach(c => {
            const a = document.createElement('a');
            a.href = '#';
            a.className = 'list-group-item list-group-item-action';
            a.textContent = `${c.name} - ${c.phone}`;
            a.onclick = async (e) => {
                e.preventDefault();
                document.getElementById('CustomerId').value = c.id;
                document.getElementById('CustomerName').value = c.name;
                document.getElementById('CustomerPhone').value = c.phone;
                customerSearch.value = c.name;
                customerResults.innerHTML = '';

                const balRes = await fetch(`/Billing/GetCustomerBalance?customerId=${c.id}`);
                const balData = await balRes.json();
                document.getElementById('previousBalanceDisplay').value = Number(balData.balance).toFixed(2);
                document.getElementById('PreviousBalance').value = balData.balance;
                recalcTotals();

                await checkLastOrder(c.id);
            };
            customerResults.appendChild(a);
        });
    }, 300));

    // ---- Repeat Last Order ----
    let lastOrderItems = [];
    const repeatOrderBox = document.getElementById('repeatOrderBox');
    const repeatOrderText = document.getElementById('repeatOrderText');
    const repeatOrderBtn = document.getElementById('repeatOrderBtn');

    async function checkLastOrder(customerId) {
        repeatOrderBox.style.display = 'none';
        try {
            const res = await fetch(`/Billing/GetLastOrder?customerId=${customerId}`);
            const data = await res.json();
            if (!data.found) return;

            lastOrderItems = data.items;
            const itemCount = lastOrderItems.length;
            repeatOrderText.textContent = `Last order on ${data.invoiceDate} — ${itemCount} item${itemCount > 1 ? 's' : ''}`;
            repeatOrderBox.style.display = 'flex';
        } catch (err) {
            // silently ignore — repeat order is a convenience, not critical
        }
    }

    repeatOrderBtn.addEventListener('click', () => {
        lastOrderItems.forEach(item => addItemToBill({
            productId: item.productId,
            name: item.name,
            size: item.size,
            unitSymbol: item.unitSymbol,
            priceType: item.priceType,
            unitPrice: item.unitPrice,
            qty: item.qty
        }));
    });

    customerSearch.addEventListener('blur', () => {
        setTimeout(() => {
            if (!document.getElementById('CustomerId').value) {
                document.getElementById('CustomerName').value = customerSearch.value;
            }
        }, 200);
    });

    // ---- Product search ----
    const productSearch = document.getElementById('productSearch');
    const productResults = document.getElementById('productResults');
    productSearch.addEventListener('input', debounce(async () => {
        const term = productSearch.value.trim();
        productResults.innerHTML = '';
        if (term.length < 2) return;
        const res = await fetch(`/Product/SearchJson?term=${encodeURIComponent(term)}`);
        const data = await res.json();
        data.forEach(p => {
            const a = document.createElement('a');
            a.href = '#';
            a.className = 'list-group-item list-group-item-action';
            a.textContent = `${p.name} - ${p.size}${p.unitSymbol} (Store ₹${p.storePrice} / MRP ₹${p.mrpPrice})`;
            a.onclick = async (e) => {
                e.preventDefault();
                document.getElementById('selectedProductId').value = p.id;
                document.getElementById('selectedProductName').value = p.name;
                document.getElementById('selectedSize').value = p.size;
                document.getElementById('selectedUnitSymbol').value = p.unitSymbol;
                document.getElementById('selectedStorePrice').value = p.storePrice;
                document.getElementById('selectedMrpPrice').value = p.mrpPrice;
                productSearch.value = `${p.name} (${p.size}${p.unitSymbol})`;
                productResults.innerHTML = '';

                const stockRes = await fetch(`/Stock/GetAvailableQty?productId=${p.id}`);
                const stockData = await stockRes.json();
                document.getElementById('availableStock').value = stockData.availableQty;
            };
            productResults.appendChild(a);
        });
    }, 300));

    document.getElementById('priceType').addEventListener('change', updateUnitPriceHint);
    function updateUnitPriceHint() {  }

    function computePrice() {
        const type = document.getElementById('priceType').value;
        const store = parseFloat(document.getElementById('selectedStorePrice').value || 0);
        const mrp = parseFloat(document.getElementById('selectedMrpPrice').value || 0);
        return type === 'StorePrice' ? store : mrp;
    }

    document.getElementById('addItemBtn').addEventListener('click', () => {
        const productId = document.getElementById('selectedProductId').value;
        const qty = parseFloat(document.getElementById('qtyInput').value);
        const available = parseFloat(document.getElementById('availableStock').value || 0);

        if (!productId) { alert('Please select the product'); return; }
        if (!qty || qty <= 0) { alert('Please enter a quantity'); return; }
        if (qty > available) { alert(`Not enough stock. Available: ${available}`); return; }

        addItemToBill({
            productId: productId,
            name: document.getElementById('selectedProductName').value,
            size: document.getElementById('selectedSize').value,
            unitSymbol: document.getElementById('selectedUnitSymbol').value,
            priceType: document.getElementById('priceType').value,
            unitPrice: computePrice(),
            qty: qty
        });

        productSearch.value = '';
        document.getElementById('qtyInput').value = '';
        document.getElementById('availableStock').value = '';
        document.getElementById('selectedProductId').value = '';
    });

    // Shared by both manual "+ Add" and barcode scan — if the same product/priceType
    // is already on the bill, bump its qty instead of adding a duplicate row.
    function addItemToBill(newItem) {
        const existing = items.find(i => i.productId == newItem.productId && i.priceType === newItem.priceType);
        if (existing) {
            existing.qty += newItem.qty;
        } else {
            items.push(newItem);
        }
        renderItems();
    }

    // ---- Barcode scan ----
    // A USB/Bluetooth barcode scanner behaves like a keyboard: it types the code
    // then sends Enter automatically. We just listen for Enter on this input.
    const barcodeInput = document.getElementById('barcodeInput');
    barcodeInput.addEventListener('keydown', async (e) => {
        if (e.key !== 'Enter') return;
        e.preventDefault();
        const code = barcodeInput.value.trim();
        barcodeInput.value = '';
        if (!code) return;

        try {
            const res = await fetch(`/Product/SearchByBarcode?code=${encodeURIComponent(code)}`);
            const p = await res.json();
            if (!p) { alert(`No product found for barcode: ${code}`); return; }

            const stockRes = await fetch(`/Stock/GetAvailableQty?productId=${p.id}`);
            const stockData = await stockRes.json();
            if (stockData.availableQty < 1) { alert(`${p.name} - out of stock`); return; }

            addItemToBill({
                productId: p.id,
                name: p.name,
                size: p.size,
                unitSymbol: p.unitSymbol,
                priceType: 'StorePrice',
                unitPrice: p.storePrice,
                qty: 1
            });
        } catch (err) {
            alert('Barcode lookup failed. Please check your connection.');
        }
    });

    function renderItems() {
        const tbody = document.getElementById('itemsTableBody');
        tbody.innerHTML = '';
        let subTotal = 0;
        items.forEach((item, idx) => {
            const amount = item.unitPrice * item.qty;
            subTotal += amount;
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td>${item.name} (${item.size}${item.unitSymbol})</td>
                <td>${item.priceType === 'StorePrice' ? 'Store Price' : 'MRP'}</td>
                <td>₹${item.unitPrice.toFixed(2)}</td>
                <td>${item.qty}</td>
                <td>₹${amount.toFixed(2)}</td>
                <td><button type="button" class="btn btn-sm btn-outline-danger" onclick="removeItem(${idx})">Remove</button></td>`;
            tbody.appendChild(tr);
        });
        document.getElementById('subTotalCell').textContent = subTotal.toFixed(2);
        recalcTotals();

        const container = document.getElementById('itemInputs');
        container.innerHTML = '';
        items.forEach((item, idx) => {
            container.innerHTML += `
                <input type="hidden" name="Items[${idx}].ProductId" value="${item.productId}" />
                <input type="hidden" name="Items[${idx}].PriceType" value="${item.priceType}" />
                <input type="hidden" name="Items[${idx}].UnitPrice" value="${item.unitPrice}" />
                <input type="hidden" name="Items[${idx}].Qty" value="${item.qty}" />`;
        });
    }

    function removeItem(idx) { items.splice(idx, 1); renderItems(); }

    function recalcTotals() {
        const subTotal = items.reduce((s, i) => s + i.unitPrice * i.qty, 0);
        const prevBalance = parseFloat(document.getElementById('PreviousBalance').value || 0);
        const grandTotal = subTotal + prevBalance;
        document.getElementById('prevBalanceCell').textContent = prevBalance.toFixed(2);
        document.getElementById('grandTotalCell').textContent = grandTotal.toFixed(2);
        updateBalanceDisplay(grandTotal);
    }

    function updateBalanceDisplay(grandTotal) {
        const paid = parseFloat(document.getElementById('paidAmountInput').value || 0);
        const total = grandTotal !== undefined ? grandTotal : parseFloat(document.getElementById('grandTotalCell').textContent);
        const balance = total - paid;
        const el = document.getElementById('balanceDisplay');
        if (balance < 0) {
            el.textContent = `Advance ₹${Math.abs(balance).toFixed(2)}`;
            el.style.color = '#0dcaf0';
        } else {
            el.textContent = balance.toFixed(2);
            el.style.color = balance > 0 ? '#dc3545' : '#198754';
        }
    }

    document.getElementById('paidAmountInput').addEventListener('input', () => updateBalanceDisplay());

    function debounce(fn, delay) {
        let timer;
        return (...args) => { clearTimeout(timer); timer = setTimeout(() => fn(...args), delay); };
    }

    document.getElementById('billingForm').addEventListener('submit', (e) => {
        if (items.length === 0) {
            e.preventDefault();
            alert('Please add at least one product to the bill.');
        }
    });

    // Edit mode: render whatever items were pre-loaded from the server, and
    // show the correct starting balance for the already-filled paid amount.
    renderItems();
    updateBalanceDisplay();
</script>
}