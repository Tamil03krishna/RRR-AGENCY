@model PaymentMode
@{ ViewData["Title"] = "New Payment Mode"; }
<h3>New Payment Mode</h3>
<form asp-action="Create" method="post" style="max-width:400px;">
    <div class="mb-3"><label class="form-label">Name (e.g. GPay, Cash)</label><input asp-for="Name" class="form-control" required /></div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
