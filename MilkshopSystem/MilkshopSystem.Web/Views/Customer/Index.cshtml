@model PagedResult<Customer>
@{
    ViewData["Title"] = "Customers";
}


<link rel="stylesheet" href="~/css/customerindex.css" />

<div class="customers-container">
    <div class="customers-header">
        <h3>Customers</h3>
        <a asp-action="Create" class="btn-new-customer">
            <span>+</span> New Customer
        </a>
    </div>

    <div class="search-container">
        <form method="get" class="search-box">
            <span class="search-icon">🔍</span>
            <input type="text" name="search" value="@Model.SearchTerm" placeholder="Name or phone search..." />
        </form>
    </div>

    <div class="customers-list">
        @if (Model.Items.Any())
        {
            foreach (var c in Model.Items)
            {
                <div class="customer-item">
                    <div class="customer-info">
                        <div class="customer-avatar">
                            @c.Name?.FirstOrDefault()
                        </div>
                        <div class="customer-details">
                            <div class="customer-name">@c.Name</div>
                            <div class="customer-phone">📱 @c.Phone</div>
                            <div class="customer-address">📍 @c.Address</div>
                        </div>
                    </div>

                    <div class="customer-outstanding">
                        <div class="outstanding-amount @(c.OutstandingBalance > 0 ? "positive" : "zero")">
                            ₹@c.OutstandingBalance.ToString("N2")
                        </div>
                        <div style="font-size:12px; color:#888;">Outstanding</div>
                    </div>

                    <div class="customer-actions">
                        <a asp-action="Details" asp-route-id="@c.Id" class="action-btn view">View</a>
                        <a asp-action="Edit" asp-route-id="@c.Id" class="action-btn edit">Edit</a>
                        <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this customer?');">
                            <button type="submit" class="action-btn delete">Delete</button>
                        </form>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <span>📋</span>
                <p style="font-size:16px; font-weight:500;">No customers found</p>
                <p style="font-size:14px; color:#aaa;">Try adjusting your search or add a new customer</p>
            </div>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="pagination-container">
            <ul class="pagination">
                @for (var p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { search = Model.SearchTerm, page = p })">@p</a>
                    </li>
                }
            </ul>
        </div>
    }
</div>