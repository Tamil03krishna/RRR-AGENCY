@model MilkshopSystem.Web.Models.ViewModels.OutstandingReportViewModel
@{ ViewData["Title"] = "Outstanding Report"; }

<link rel="stylesheet" href="~/css/dashboard.css" />

<div class="dashboard-header">
    <div class="row align-items-center">
        <div class="col-md-8">
            <h3>💳 Outstanding Report</h3>
            <p class="subtitle">Who owes the shop, and who's paid in advance.</p>
        </div>
        <div class="col-md-4 text-md-end">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">← Customer List</a>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card stat-card bg-gradient-danger text-white">
            <div class="card-body">
                <div class="stat-icon">🔴</div>
                <div class="stat-label">Total Due</div>
                <div class="stat-value">₹@Model.TotalDue.ToString("N2")</div>
                <div class="stat-change">Customers who paid less than the bill</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card bg-gradient-info text-white">
            <div class="card-body">
                <div class="stat-icon">🔵</div>
                <div class="stat-label">Total Advance</div>
                <div class="stat-value">₹@Model.TotalAdvance.ToString("N2")</div>
                <div class="stat-change">Customers who paid more than the bill</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card bg-gradient-primary text-white">
            <div class="card-body">
                <div class="stat-icon">⚖️</div>
                <div class="stat-label">Net Outstanding</div>
                <div class="stat-value">₹@Model.NetOutstanding.ToString("N2")</div>
                <div class="stat-change">Total Due − Total Advance</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card product-table-card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><span class="text-danger">🔴</span> Due <span class="badge bg-danger ms-2 rounded-pill">@Model.DueCustomers.Count</span></h5>
            </div>
            <div class="card-body p-0">
                @if (!Model.DueCustomers.Any())
                {
                    <div class="text-center text-muted py-5">
                        <div style="font-size:2rem;">🎉</div>
                        <div>No one owes the shop right now.</div>
                    </div>
                }
                else
                {
                    var dueColors = new[] { "#fc8181", "#e53e3e", "#f56565" };
                    <div class="table-responsive">
                        <table class="table mb-0" id="dueTable">
                            <thead>
                                <tr><th>Customer</th><th>Phone</th><th class="text-end">Due Amount</th></tr>
                            </thead>
                            <tbody>
                            @{ int dIdx = 0; }
                            @foreach (var c in Model.DueCustomers)
                            {
                                <tr>
                                    <td>
                                        <div class="product-name-cell">
                                            <div class="product-avatar" style="background:@dueColors[dIdx % dueColors.Length];">@c.Name.Substring(0,1).ToUpper()</div>
                                            <a asp-action="Details" asp-route-id="@c.Id" class="text-decoration-none fw-semibold">@c.Name</a>
                                        </div>
                                    </td>
                                    <td class="text-muted">@c.Phone</td>
                                    <td class="text-end"><span class="badge bg-danger" style="font-size:0.85rem;">₹@c.OutstandingBalance.ToString("N2")</span></td>
                                </tr>
                                dIdx++;
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card product-table-card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><span class="text-info">🔵</span> Advance <span class="badge bg-info ms-2 rounded-pill">@Model.AdvanceCustomers.Count</span></h5>
            </div>
            <div class="card-body p-0">
                @if (!Model.AdvanceCustomers.Any())
                {
                    <div class="text-center text-muted py-5">
                        <div style="font-size:2rem;">✅</div>
                        <div>No one has an advance balance.</div>
                    </div>
                }
                else
                {
                    var advColors = new[] { "#4299e1", "#3182ce", "#63b3ed" };
                    <div class="table-responsive">
                        <table class="table mb-0" id="advanceTable">
                            <thead>
                                <tr><th>Customer</th><th>Phone</th><th class="text-end">Advance Amount</th></tr>
                            </thead>
                            <tbody>
                            @{ int aIdx = 0; }
                            @foreach (var c in Model.AdvanceCustomers)
                            {
                                <tr>
                                    <td>
                                        <div class="product-name-cell">
                                            <div class="product-avatar" style="background:@advColors[aIdx % advColors.Length];">@c.Name.Substring(0,1).ToUpper()</div>
                                            <a asp-action="Details" asp-route-id="@c.Id" class="text-decoration-none fw-semibold">@c.Name</a>
                                        </div>
                                    </td>
                                    <td class="text-muted">@c.Phone</td>
                                    <td class="text-end"><span class="badge bg-info text-dark" style="font-size:0.85rem;">₹@Math.Abs(c.OutstandingBalance).ToString("N2")</span></td>
                                </tr>
                                aIdx++;
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
