@model User
@{ ViewData["Title"] = "User Details"; }
<h3>User Details</h3>
<table class="table table-bordered bg-white" style="max-width:500px;">
    <tr><th>Username</th><td>@Model.Username</td></tr>
    <tr><th>Full Name</th><td>@Model.FullName</td></tr>
    <tr><th>Role</th><td><span class="badge bg-secondary">@(Model.RoleName ?? Model.Role)</span></td></tr>
    <tr><th>Status</th><td>@(Model.IsActive ? "Active" : "Inactive")</td></tr>
    <tr><th>Created</th><td>@Model.CreatedDate.ToString("dd-MMM-yyyy hh:mm tt")</td></tr>
</table>
<a asp-action="Index" class="btn btn-secondary">← Back to Users</a>
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
<a asp-action="Access" asp-route-id="@Model.Id" class="btn btn-dark">Manage Access</a>
